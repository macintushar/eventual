{
  "name": "eventual",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "api:docs:generate": "tsx scripts/generate-openapi.ts",
    "api:docs:check": "tsx scripts/generate-openapi.ts --check",
    "test": "TURSO_DATABASE_URL=:memory: BETTER_AUTH_SECRET=local-test-secret-at-least-thirty-two-characters tsx --test 'src/**/*.test.ts'",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --project=chromium --project=mobile",
    "test:e2e:states": "playwright test states.ui.spec.ts --project=chromium --project=mobile",
    "test:integration": "playwright test --project=api",
    "test:keys": "playwright test api-keys.spec.ts --project=api",
    "email:dev": "email dev --dir src/emails --port 3002",
    "dev": "vite dev --port 3000",
    "generate-routes": "bun scripts/generate-routes.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "shortcut:build": "tsx scripts/build-shortcut.ts",
    "api:generate": "tsx scripts/generate-api-client.ts && biome check --write src/lib/api-client.gen.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/api-key": "1.7.7",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@faker-js/faker": "^10.3.0",
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@posthog/react": "^1.10.6",
    "@scalar/api-reference-react": "^0.9.77",
    "@sentry/tanstackstart-react": "^10.74.0",
    "@t3-oss/env-core": "^0.13.10",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/match-sorter-utils": "latest",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "latest",
    "@tanstack/react-hotkeys": "^0.12.1",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-query-devtools": "^5.103.2",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "1.168.60",
    "@tanstack/react-table": "latest",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.5",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.577.0",
    "motion": "^13.3.0",
    "next-themes": "^0.4.6",
    "nitro": "3.0.260610-beta",
    "posthog-js": "^1.430.3",
    "posthog-node": "^5.52.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.0",
    "react-email": "^6.9.5",
    "resend": "^6.28.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@playwright/test": "^1.63.0",
    "@react-email/ui": "6.9.5",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.3.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  }
}
