# Local development. Replace with libsql://<db>-<org>.turso.io for Turso Cloud.
TURSO_DATABASE_URL=file:local.db
# Required for Turso Cloud; leave empty for a local file database.
TURSO_AUTH_TOKEN=
# Generate with: bunx --bun @better-auth/cli secret
BETTER_AUTH_SECRET=replace-with-at-least-32-characters
# Public app origin shared by Better Auth and Integrations (Shortcut, MCP, API URLs).
# Set to your deployed HTTPS origin in production, e.g. https://app.example.com.
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (optional): use the callback URI
# http://localhost:3000/api/auth/callback/google locally, and
# https://your-domain.com/api/auth/callback/google in production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend: use a sender on a domain verified in your Resend account.
RESEND_API_KEY=
EMAIL_FROM=
# Optional support/reply address.
EMAIL_REPLY_TO=
# Optional public support address shown on the help contact section.
SUPPORT_EMAIL=

# Optional: who runs this instance and whose law governs its terms, e.g.
# LEGAL_OPERATOR_NAME="Jane Doe" and LEGAL_GOVERNING_LAW="India". Left empty,
# /privacy and /terms describe an independently run open-source instance.
LEGAL_OPERATOR_NAME=
LEGAL_GOVERNING_LAW=
# Optional address for privacy, deletion and legal requests. Without it, the
# pages ask people to contact the operator directly.
LEGAL_CONTACT_EMAIL=
# Optional country the database is stored in, e.g. "India".
LEGAL_DATA_LOCATION=

# Error monitoring. The auth token is build-only and uploads source maps.
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Count-only product analytics. Use the regional ingestion host for your project.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com
