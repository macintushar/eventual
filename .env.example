# Local development. Replace with libsql://<db>-<org>.turso.io for Turso Cloud.
TURSO_DATABASE_URL=file:local.db
# Required for Turso Cloud; leave empty for a local file database.
TURSO_AUTH_TOKEN=
# Generate with: bunx --bun @better-auth/cli secret
BETTER_AUTH_SECRET=replace-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
