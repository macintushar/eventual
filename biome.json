{
	"$schema": "https://biomejs.dev/schemas/2.4.5/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"apps/web/e2e/**/*",
			"apps/web/playwright.config.ts",
			"apps/web/scripts/run-e2e.mjs",
			"apps/web/src/**/*",
			"apps/web/index.html",
			"apps/web/vite.config.ts",
			"apps/web/scripts/generate-openapi.ts",
			"apps/web/tests/e2e/**/*",
			"packages/*/src/**/*",
			"packages/*/package.json",
			".vscode/**/*",
			"package.json",
			"turbo.json",
			"!**/.output",
			"!**/src/routeTree.gen.ts",
			"!**/src/styles.css"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"overrides": [
		{
			"includes": ["**/e2e/**/*"],
			"linter": { "rules": { "suspicious": { "noExplicitAny": "off" } } }
		}
	],
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
